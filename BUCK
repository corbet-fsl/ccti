# Hand-written Buck2 targets for ccti (third-party crates come from //third-party, generated by reindeer).
DEPS = [
    "//third-party:" + n
    for n in ["anyhow", "base64", "ccht", "crossterm", "futures", "image", "png", "ratatui", "ratatui-image", "reqwest", "serde", "serde_json", "tokio", "unicode-width"]
]

rust_binary(
    name = "ccti",
    srcs = glob(["src/**/*.rs"]),
    crate_root = "src/main.rs",
    edition = "2024",
    env = {"CARGO_PKG_VERSION": "0.1.10"},
    deps = DEPS,
)

# Unit tests inside the binary crate (cargo test).
rust_test(
    name = "ccti-unit",
    srcs = glob(["src/**/*.rs"]),
    crate = "ccti",
    crate_root = "src/main.rs",
    edition = "2024",
    env = {"CARGO_PKG_VERSION": "0.1.10"},
    deps = DEPS,
)
